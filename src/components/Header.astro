---
import ContourButton from "./ContourButton.astro";

const links = [
  { label: "Work", href: "#", active: false },
  { label: "Blog", href: "/", active: true },
  { label: "About", href: "#", active: false },
];
---

<header
  class="flex h-[104px] w-full shrink-0 items-center justify-between border-b px-6 md:px-12 xl:px-24"
>
  <a href="/" class="flex items-center gap-4">
    <img src="/assets/logo.svg" alt="mmagdiel logo" class="size-10" />
    <span class="whitespace-nowrap text-sm font-medium leading-[1.5]"
      >Magdiel Márquez</span
    >
  </a>
  <nav class="flex items-center gap-4 sm:gap-8">
    {
      links.map((link) =>
        link.active ? (
          <a
            href={link.href}
            aria-current="page"
            class="flex items-center gap-2"
          >
            <span class="size-[5px] bg-brand" />
            <span class="whitespace-nowrap text-sm font-medium leading-[1.5] text-brand">
              {link.label}
            </span>
          </a>
        ) : (
          <a
            href={link.href}
            class="whitespace-nowrap text-sm font-medium leading-[1.5] text-text-secondary transition-colors duration-200 hover:text-text-primary"
          >
            {link.label}
          </a>
        ),
      )
    }
    <div class="hidden items-center gap-2 md:flex">
      <ContourButton label="Let’s talk" href="#" />
      <img src="/assets/arrow-up-right.svg" alt="" class="size-[18px]" />
    </div>
  </nav>
</header>
